[
  {
    "id": "arg_001",
    "dimension": "args",
    "prompt": "Convert 100 US dollars to euros",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "convert_currency",
          "description": "Convert an amount from one currency to another",
          "parameters": {
            "type": "object",
            "properties": {
              "amount": { "type": "number", "description": "Amount to convert" },
              "from_currency": { "type": "string", "description": "Source currency code (ISO 4217)" },
              "to_currency": { "type": "string", "description": "Target currency code (ISO 4217)" }
            },
            "required": ["amount", "from_currency", "to_currency"]
          }
        }
      }
    ],
    "expected": {
      "calls": [{ "name": "convert_currency", "args": { "amount": 100, "from_currency": "USD", "to_currency": "EUR" }, "argsMatchMode": "exact" }]
    },
    "difficulty": "easy"
  },
